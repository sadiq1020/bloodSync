# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
# Pooled connection string with PgBouncer / pooled endpoint (used for Prisma Client queries)
DATABASE_URL=postgresql://user:password@ep-bloodsync-pooler.us-east-2.aws.neon.tech/bloodsync?sslmode=require
# Direct connection string bypassing pooler (used by Prisma migrations and CLI)
DIRECT_URL=postgresql://user:password@ep-bloodsync.us-east-2.aws.neon.tech/bloodsync?sslmode=require

# Better Auth Configuration
# Secret key used to sign and encrypt session tokens and cookies (min 32 random characters)
BETTER_AUTH_SECRET=super-secret-random-32-char-string-for-bloodsync-auth
# Public base URL of the auth service (set to the frontend domain when proxied, e.g. https://bloodsync.vercel.app or http://localhost:5000)
BETTER_AUTH_URL=http://localhost:5000

# Client Application URL (public origin of the frontend for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# OpenRouter (AI Model API for parsing blood request text)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=30000

# Seed Credentials (used by npm run seed and npm run seed:demo)
ADMIN_EMAIL=admin@bloodsync.com
ADMIN_PASSWORD=Admin@123456
DEMO_PASSWORD=Demo@123456
