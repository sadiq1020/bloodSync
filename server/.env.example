# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
# Pooled connection URL (used by Prisma Client / runtime queries)
DATABASE_URL=postgresql://user:password@ep-bloodsync-pooler.us-east-2.aws.neon.tech/bloodsync?sslmode=require
# Direct connection URL (used for Prisma migrations)
DIRECT_URL=postgresql://user:password@ep-bloodsync.us-east-2.aws.neon.tech/bloodsync?sslmode=require

# Better Auth Configuration
BETTER_AUTH_SECRET=super-secret-random-32-char-string-for-bloodsync-auth
BETTER_AUTH_URL=http://localhost:5000

# Client Application URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# OpenRouter (Gemini for Blood Request Text Parsing)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
